<?xml version="1.0" encoding="utf-8"?>
<resources
	xmlns:android="http://schemas.android.com/apk/res/android">

	<style name="BaseTextStyle">
		<item name="android:includeFontPadding">false</item>
		<item name="android:ellipsize">end</item>
	</style>

	<style name="HeadlineVariantFirstStyle" parent="BaseTextStyle">
		<item name="android:maxLines">1</item>
		<item name="android:textSize">@dimen/text_size_04</item>
		<item name="android:fontFamily">@font/roboto_regular</item>
	</style>

	<style name="HeadlineVariantSecondStyle" parent="BaseTextStyle">
		<item name="android:gravity">end|center_vertical</item>
		<item name="android:maxLines">1</item>
		<item name="android:letterSpacing">0.15</item>
		<item name="android:textSize">@dimen/text_size_03</item>
		<item name="android:textColor">@color/zurich_blue_100</item>
		<item name="android:fontFamily">@font/roboto_medium</item>
	</style>

	<style name="ButtonStyle" parent="BaseTextStyle">
		<item name="android:maxLines">1</item>
		<item name="android:drawablePadding">@dimen/padding_01</item>
		<item name="android:paddingStart">@dimen/padding_02</item>
		<item name="android:paddingEnd">@dimen/padding_02</item>
		<item name="android:stateListAnimator">@null</item>
		<item name="android:background">@drawable/bg_button</item>
		<item name="android:letterSpacing">0.15</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:textSize">@dimen/text_size_02</item>
		<item name="android:textColor">@color/white_100</item>
		<item name="android:fontFamily">@font/roboto_black</item>
	</style>

	<style name="SubtitleStyle" parent="BaseTextStyle">
		<item name="android:gravity">start|center_vertical</item>
		<item name="android:maxLines">1</item>
		<item name="android:letterSpacing">0.1</item>
		<item name="android:lineHeight">@dimen/line_height_02</item>
		<item name="android:textSize">@dimen/text_size_02</item>
		<item name="android:textColor">@color/black_100</item>
		<item name="android:fontFamily">@font/roboto_black</item>
	</style>

	<style name="CaptionStyle" parent="BaseTextStyle">
		<item name="android:letterSpacing">0.09</item>
		<item name="android:lineHeight">@dimen/line_height_01</item>
		<item name="android:textSize">@dimen/text_size_01</item>
		<item name="android:textColor">@color/panda_black_100</item>
		<item name="android:fontFamily">@font/roboto_regular</item>
	</style>

	<style name="BrandShapeStyle">
		<item name="android:src">@mipmap/bg_brand_shape</item>
		<item name="android:scaleType">centerCrop</item>
	</style>
</resources>